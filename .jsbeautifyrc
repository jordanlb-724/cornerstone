{
    "align_assignments": true,
    "arrow_parens": "always",
    "brace_style": "collapse,preserve-inline",
    "content_unformatted": ["pre", "code", "textarea", "---", "YAML", "{{/if}}", "{{#if"],
    "css": {
        "newline_between_rules": true,
        "selector_separator_newline": false
    },
    "e4x": false,
    "editorconfig": false,
    "end-with-newline": false,
    "end_with_newline": false,
    "eol": "\n",
    "eval_code": false,
    "extra_liners": ["head", "body", "html", "/html"],
    "force_indentation": true,
    "html": {
        "end-with-newline": false,
        "end_with_newline": false,
        "wrap_line_length": 0
    },
    "indent_body_inner_html": true,
    "indent_char": " ",
    "indent_comments": true,
    "indent_empty_lines": false,
    "indent_handlebars": true,
    "indent_head_inner_html": true,
    "indent_inner_html": true,
    "indent_level": 0,
    "indent_scripts": "normal",
    "indent_size": 4,
    "indent_style": "space",
    "indent_with_tabs": false,
    "inline": [
        "a",
        "data-slick",
        "abbr",
        "area",
        "audio",
        "b",
        "bdi",
        "bdo",
        "br",
        "button",
        "canvas",
        "cite",
        "code",
        "data",
        "datalist",
        "del",
        "dfn",
        "em",
        "embed",
        "i",
        "iframe",
        "img",
        "input",
        "ins",
        "kbd",
        "keygen",
        "label",
        "map",
        "mark",
        "math",
        "meter",
        "noscript",
        "object",
        "output",
        "progress",
        "q",
        "ruby",
        "s",
        "samp",
        "select",
        "small",
        "span",
        "strong",
        "sub",
        "sup",
        "svg",
        "template",
        "textarea",
        "time",
        "u",
        "var",
        "video",
        "wbr",
        "text",
        "acronym",
        "address",
        "big",
        "dt",
        "ins",
        "strike",
        "tt"
    ],
    "js": {
        "wrap_line_length": 120
    },
    "keep_array_indentation": false,
    "keep_function_indentation": false,
    "max_preserve_newlines": 1,
    "operator_position": "before-newline",
    "preserve_newlines": true,
    "tab_size": 2,
    "templating": ["handlebars", "erb", "django", "auto"],
    "unescape_strings": false,
    "unformatted": ["{{", "}}", "pre", "code", "textarea", "---", "YAML"],
    "unformatted_content_delimiter": "---",
    "unindent_chained_methods": false,
    "void_elements": [
        "area",
        "base",
        "br",
        "col",
        "embed",
        "hr",
        "img",
        "input",
        "keygen",
        "link",
        "menuitem",
        "meta",
        "param",
        "source",
        "track",
        "wbr",
        "!doctype",
        "?xml",
        "?php",
        "?=",
        "basefont",
        "isindex"
    ],
    "wrap_attributes": "force-aligned",
    "wrap_attributes_indent_size": 4,
    "wrap_attributes_min_attrs": 3,
    "wrap_line_length": 0
}
