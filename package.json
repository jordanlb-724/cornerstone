    "license": "MIT",
    "name": "bigcommerce-cornerstone",
    "private": true,
    "scripts": {
        "beautify-write-all": "js-beautify --html -r **/*.html --config .jsbeautifyrc",
        "build": "rm -rf assets/dist && npx webpack --config webpack.prod.js",
        "buildDev": "rm -rf assets/dist && npx webpack --config webpack.dev.js",
        "curlylint-check-templates": "curlylint templates",
        "djhtml-indent-all": "npx djhtml . -t 4",
        "djlint-check-all": "djlint . --extension=.html --check --profile=handlebars",
        "djlint-format-all": "djlint . --extension=.html --reformat --profile=handlebars",
        "djlint-lint-check-templates": "djlint . --extension=.html --lint --profile=handlebars --include=h017,h035,h037,h008,h014,h009,h012,h024 --ignore=h013,h015,h007,h019,h021,h031,h030",
        "eslint-check": "npx eslint **/*.{js,jsx,ts,tsx}",
        "eslint-fix": "npx eslint --fix **/*.{js,jsx,ts,tsx}",
        "git-check": "git fsck --full",
        "git-fix": "git gc --aggressive --prune=now",
        "gitbash-clean-all": "rm -rf node_modules assets/dist package-lock.json",
        "grunt-svg-store": "grunt svgstore",
        "html_hint-check-other": "htmlhint _other/**/*.html",
        "html_hint-check-templates": "htmlhint templates/**/*.html",
        "open": "npx stencil start --open -v Light -c 1 --verbose",
        "prettier-check-html": "npx prettier --check **/*.html --config .prettierrc.json",
        "prettier-check-js": "npx prettier --check **/*.{js,jsx,ts,tsx} --config .prettierrc.json",
        "prettier-check-scss": "npx prettier --check **/*.{scss,css} --config .prettierrc.json",
        "prettier-fix-all": "npx prettier --write . --config .prettierrc.json --ignore-unknown",
        "prettier-fix-html": "npx prettier --write **/*.html --config .prettierrc.json --ignore-unknown",
        "prettier-fix-js": "npx prettier --write **/*.{js,jsx,ts,tsx} --config .prettierrc.json --ignore-unknown",
        "prettier-fix-json": "npx prettier --write **/*.json --config .prettierrc.json --ignore-unknown",
        "prettier-fix-scss": "npx prettier --write **/*.{scss,css} --config .prettierrc.json --ignore-unknown",
        "stencil-autofix-scss": "npx stencil scss-autofix --dry",
        "stencil-build-dev": "npx webpack --config webpack.dev.js",
        "stencil-bundle": "rm -rf assets/dist && npx stencil bundle",
        "stencil-push-apply": "npx stencil push -a",
        "stencil-push-sourcemaps": "npx stencil push -a --source-maps",
        "stencil-start-light": "npx stencil start -v Light -c 1",
        "stylelint": "npx stylelint **/*.scss",
        "stylelint-check-all": "npx stylelint **/*.{scss,css}",
        "stylelint-fix-all": "npx stylelint **/*.{scss,css} --fix",
        "stylelint:fix": "npx stylelint --fix **/*.scss",
        "test": "npx jest",
        "webhint-check-all": "npx hint -c .hintrc ."
    },
    "version": "6.16.2"
}
